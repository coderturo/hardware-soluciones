---
import { SITE_CONFIG, SERVICES } from '@/data/siteData';
---

<footer class="bg-card border-t border-border text-foreground pt-16 pb-28 sm:pb-24 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Top 4-column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Brand & Mission (Col 1-4) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="#top" class="inline-block focus:outline-none">
          <img src="/images/logo.svg" alt={SITE_CONFIG.name} class="h-10 w-auto" />
        </a>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {SITE_CONFIG.description}
        </p>
        <div class="pt-2">
          <p class="text-xs uppercase tracking-widest text-primary font-bold">
            Hardware · CCTV · IoT · Redes
          </p>
          <p class="text-xs text-muted-foreground mt-0.5">
            Sede en Callao, cobertura en toda Lima Metropolitana.
          </p>
        </div>
      </div>

      <!-- Quick Nav (Col 5-6) -->
      <div class="lg:col-span-2 space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-foreground">
          Navegación
        </p>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href="#top" class="hover:text-primary transition-colors">Inicio</a>
          </li>
          <li>
            <a href="#servicios" class="hover:text-primary transition-colors">Servicios</a>
          </li>
          <li>
            <a href="#catalogo" class="hover:text-primary transition-colors">Catálogo de Partes</a>
          </li>
          <li>
            <a href="#nosotros" class="hover:text-primary transition-colors">Nosotros</a>
          </li>
          <li>
            <a href="#contacto" class="hover:text-primary transition-colors">Contacto</a>
          </li>
        </ul>
      </div>

      <!-- Services List (Col 7-9) -->
      <div class="lg:col-span-3 space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-foreground">
          Servicios Especializados
        </p>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {SERVICES.map((s) => (
            <li>
              <a href="#servicios" class="hover:text-primary transition-colors line-clamp-1">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info (Col 10-12) -->
      <div class="lg:col-span-3 space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-foreground">
          Atención al Cliente
        </p>
        <div class="space-y-2.5 text-xs text-muted-foreground">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{SITE_CONFIG.address}</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href={`tel:${SITE_CONFIG.phoneRaw}`} class="hover:text-primary transition-colors font-medium">
              {SITE_CONFIG.phone}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-primary transition-colors">
              {SITE_CONFIG.email}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>{SITE_CONFIG.hours}</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal line -->
    <div class="pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <p>
        &copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-2">
        <span>Precios en Soles (PEN) con IGV</span>
        <span>•</span>
        <span>Callao - Lima, Perú</span>
      </p>
    </div>

  </div>
</footer>
