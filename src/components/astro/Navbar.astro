---
import { SITE_CONFIG } from '@/data/siteData';
import { ThemeToggle } from '../react/ThemeToggle';
import { MobileNav } from '../react/MobileNav';
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/85 backdrop-blur-md transition-colors duration-200">
  <!-- Top bar info (visible on desktop) -->
  <div class="hidden sm:block border-b border-border/50 bg-muted/40 py-1.5 px-4 sm:px-6 lg:px-8 text-xs text-muted-foreground">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          {SITE_CONFIG.address}
        </span>
        <span class="hidden md:flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {SITE_CONFIG.hours}
        </span>
      </div>
      <div class="flex items-center gap-4">
        <a 
          href={`tel:${SITE_CONFIG.phoneRaw}`} 
          class="hover:text-primary transition-colors flex items-center gap-1 font-medium"
        >
          <svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {SITE_CONFIG.phone}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="#top" class="flex items-center gap-2 group focus:outline-none" aria-label="Ir al inicio">
      <img 
        src="/images/logo.svg" 
        alt={SITE_CONFIG.name} 
        class="h-9 sm:h-10 w-auto transition-transform group-hover:scale-[1.02]" 
      />
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium text-foreground">
      <a 
        href="#top" 
        class="px-3 py-1.5 rounded-lg hover:bg-accent hover:text-primary transition-colors"
      >
        Inicio
      </a>
      <a 
        href="#servicios" 
        class="px-3 py-1.5 rounded-lg hover:bg-accent hover:text-primary transition-colors"
      >
        Servicios
      </a>
      <a 
        href="#catalogo" 
        class="px-3 py-1.5 rounded-lg hover:bg-accent hover:text-primary transition-colors"
      >
        Catálogo
      </a>
      <a 
        href="#nosotros" 
        class="px-3 py-1.5 rounded-lg hover:bg-accent hover:text-primary transition-colors"
      >
        Nosotros
      </a>
      <a 
        href="#contacto" 
        class="px-3 py-1.5 rounded-lg hover:bg-accent hover:text-primary transition-colors"
      >
        Contacto
      </a>
    </nav>

    <!-- Desktop Actions (Theme Toggle + WhatsApp CTA) -->
    <div class="hidden md:flex items-center gap-3">
      <ThemeToggle client:load />

      <a
        href={`${SITE_CONFIG.whatsappBaseUrl}?text=Hola%20Hardware%20%26%20Soluciones,%20deseo%20solicitar%20una%20cotizaci%C3%B3n.`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 h-10 px-4 rounded-xl bg-[#0f766e] hover:bg-[#115e59] dark:bg-[#14b8a6] dark:hover:bg-[#0d9488] text-white dark:text-slate-950 font-bold text-xs lg:text-sm shadow-xs transition-all active:scale-95"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        <span>Cotizar por WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Nav Component -->
    <MobileNav client:load />
  </div>
</header>
