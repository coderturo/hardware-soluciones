---
import { SITE_CONFIG } from '@/data/siteData';
---

<section class="relative isolate overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 lg:pt-20 lg:pb-32 bg-background">
  <!-- Subtle tech grid background -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:32px_32px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <!-- Tech Badge Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-border bg-muted/60 text-foreground text-xs font-semibold tracking-wide">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
          <span>Tecnología, Cómputo y Seguridad Electrónica en Lima y Callao</span>
        </div>

        <!-- Main Headline (Solid colors, no gradient AI tell) -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-[1.12]">
          Tu infraestructura tecnológica, <br class="hidden sm:inline" />
          <span class="text-primary">
            en manos expertas.
          </span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Venta de componentes originales de cómputo, asesoramiento para armado de PCs a medida, mantenimiento e instalación de cámaras de videovigilancia y redes IoT para hogares, oficinas y empresas.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <!-- Primary WhatsApp CTA (Accessible Darker WhatsApp Green for WCAG contrast) -->
          <a
            href={`${SITE_CONFIG.whatsappBaseUrl}?text=Hola%20Hardware%20%26%20Soluciones,%20deseo%20asesor%C3%ADa%20y%20cotizaci%C3%B3n.`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 sm:h-14 px-7 rounded-xl bg-[#0f766e] hover:bg-[#115e59] dark:bg-[#14b8a6] dark:hover:bg-[#0d9488] text-white dark:text-slate-950 font-bold text-sm sm:text-base shadow-sm hover:shadow transition-all active:scale-95"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>Solicitar Asesoría por WhatsApp</span>
          </a>

          <!-- Secondary Explore CTA -->
          <a
            href="#catalogo"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 h-12 sm:h-14 px-7 rounded-xl bg-secondary hover:bg-accent text-secondary-foreground font-semibold text-sm sm:text-base border border-border shadow-xs hover:shadow transition-all"
          >
            <span>Ver Catálogo Destacado</span>
            <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Trust Features Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-border text-left">
          <div class="space-y-1">
            <p class="text-sm font-bold text-foreground">Garantía Escrita</p>
            <p class="text-xs text-muted-foreground">Componentes 100% nuevos en caja sellada con número de serie.</p>
          </div>

          <div class="space-y-1">
            <p class="text-sm font-bold text-foreground">Soporte Técnico</p>
            <p class="text-xs text-muted-foreground">Diagnóstico preciso y armado profesional de computadoras.</p>
          </div>

          <div class="space-y-1">
            <p class="text-sm font-bold text-foreground">Envíos & Entrega</p>
            <p class="text-xs text-muted-foreground">Cobertura rápida en Callao y todos los distritos de Lima.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Tech Showcase (Flattened, no nested cards) -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-border bg-card shadow-lg p-5 sm:p-7 space-y-6">
          
          <!-- Image Box with Status -->
          <div class="relative aspect-video rounded-2xl overflow-hidden bg-slate-900 border border-border">
            <img 
              src="/images/hero-tech.webp" 
              alt="Infraestructura y Tecnología" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            

            <div class="absolute bottom-3 left-4 right-4 text-white">
              <p class="text-xs font-medium text-slate-300">Soluciones Integrales</p>
              <p class="text-base sm:text-lg font-bold">Hardware de Alto Rendimiento & CCTV</p>
            </div>
          </div>

          <!-- Flattened Info Rows -->
          <div class="divide-y divide-border text-sm">
            <div class="py-3 flex items-center justify-between">
              <span class="text-muted-foreground">Horario de Atención</span>
              <span class="font-semibold text-foreground">Lun - Sáb: 9:00 am - 7:00 pm</span>
            </div>
            <div class="py-3 flex items-center justify-between">
              <span class="text-muted-foreground">Sede Callao</span>
              <span class="font-semibold text-foreground">Calle Pablo de Olavide 329</span>
            </div>
            <div class="py-3 flex items-center justify-between">
              <span class="text-muted-foreground">Atención WhatsApp</span>
              <a 
                href={`${SITE_CONFIG.whatsappBaseUrl}?text=Hola%20Hardware%20%26%20Soluciones,%20deseo%20hacer%20una%20consulta.`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-primary hover:underline flex items-center gap-1"
              >
                +51 981 083 288 →
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
