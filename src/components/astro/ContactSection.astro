---
import { SITE_CONFIG } from '@/data/siteData';
import { ContactForm } from '../react/ContactForm';
---

<section id="contacto" class="py-20 sm:py-28 bg-muted/20 border-t border-border relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wider uppercase">
        Contacto y Cotizaciones
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-foreground tracking-tight">
        Cuéntanos tu proyecto y te asesoramos al instante
      </h2>
      <p class="text-base sm:text-lg text-muted-foreground">
        Completa el formulario con tu consulta técnica o escríbenos directamente por WhatsApp. Un especialista te brindará una cotización exacta y disponibilidad en Lima y Callao.
      </p>
    </div>

    <!-- Contact Container (2 cols: Info + Form) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Info Left Column -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Quick WhatsApp Box -->
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-500/20 space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-md">
            <svg class="w-6 h-6 fill-current stroke-none" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-xl font-bold text-foreground">¿Prefieres atención inmediata?</h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
              El canal más rápido para cotizar componentes, consultar stock o solicitar un técnico a domicilio es nuestro WhatsApp.
            </p>
          </div>
          <a
            href={`${SITE_CONFIG.whatsappBaseUrl}?text=Hola%20Hardware%20%26%20Soluciones,%20deseo%20una%20cotizaci%C3%B3n.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0f766e] hover:bg-[#115e59] dark:bg-[#14b8a6] dark:hover:bg-[#0d9488] text-white dark:text-slate-950 font-bold text-xs sm:text-sm shadow-xs transition-all"
          >
            Chatear al +51 981 083 288
          </a>
        </div>

        <!-- Info Cards List -->
        <div class="space-y-4">
          <div class="p-4 rounded-2xl bg-card border border-border flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-muted-foreground font-semibold">Teléfono Directo</p>
              <a href={`tel:${SITE_CONFIG.phoneRaw}`} class="text-base font-bold text-foreground hover:text-primary transition-colors">
                {SITE_CONFIG.phone}
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">Llamadas y WhatsApp empresarial</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-border flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-muted-foreground font-semibold">Correo Electrónico</p>
              <a href={`mailto:${SITE_CONFIG.email}`} class="text-base font-bold text-foreground hover:text-primary transition-colors">
                {SITE_CONFIG.email}
              </a>
              <p class="text-xs text-muted-foreground mt-0.5">{SITE_CONFIG.emailAlt}</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-border flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-muted-foreground font-semibold">Ubicación y Taller</p>
              <p class="text-sm font-bold text-foreground">{SITE_CONFIG.address}</p>
              <a 
                href={SITE_CONFIG.mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs text-primary font-medium hover:underline inline-flex items-center gap-1 mt-1"
              >
                <span>Ver en Google Maps</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17 17 7M7 7h10v10"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-card border border-border flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-muted-foreground font-semibold">Horario de Atención</p>
              <p class="text-sm font-bold text-foreground">{SITE_CONFIG.hours}</p>
              <p class="text-xs text-muted-foreground mt-0.5">Soporte y emergencias 24/7 para empresas</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Form Right Column -->
      <div class="lg:col-span-7 bg-card rounded-3xl border border-border p-6 sm:p-10 shadow-xl space-y-6">
        <div>
          <h3 class="text-2xl font-black text-foreground">Solicitud de Cotización en Línea</h3>
          <p class="text-sm text-muted-foreground mt-1">
            Completa los siguientes campos validados con Zod para registrar tu solicitud.
          </p>
        </div>

        <!-- React Contact Form with Zod -->
        <ContactForm client:visible />
      </div>

    </div>

  </div>
</section>
